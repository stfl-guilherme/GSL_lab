# Copie este arquivo para ".env" e ajuste. O ".env" não vai para o git.

# Nomes de host extras aceitos pelo servidor de dev em modo rede (npm run dev:lan),
# separados por vírgula. Só é usado em desenvolvimento.
# Acesso por IP (ex.: http://192.168.0.10:5173) funciona com isto vazio;
# preencha apenas para abrir por nome, ex.: DEV_EXTRA_HOSTS=meu-pc.local
DEV_EXTRA_HOSTS=
